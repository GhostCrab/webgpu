{
    "name": "webgpu-verlet",
    "version": "0.1.0",
    "description": "A GPU-driven 2D Verlet particle simulation in WebGPU compute shaders.",
    "main": "dist/main.js",
    "engines": {
        "node": ">=21"
    },
    "scripts": {
        "start": "npm i && npm run dev",
        "serve": "http-server",
        "dev": "concurrently \"cross-env NODE_ENV=development ts-node webpack.ts --watch\" \"http-server\"",
        "prod": "concurrently \"cross-env NODE_ENV=production ts-node webpack.ts --watch\" \"http-server\"",
        "prod-build": "cross-env NODE_ENV=production ts-node webpack.ts",
        "test": "vitest run --root .",
        "bench": "vitest run --root . --config vitest.bench.config.mts",
        "typecheck": "tsc --noEmit && tsc --noEmit -p test",
        "lint": "eslint .",
        "prepare": "node -e \"try{require('child_process').execSync('git config core.hooksPath .githooks',{stdio:'ignore'})}catch{}\""
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/GhostCrab/webgpu.git"
    },
    "keywords": [
        "webgpu",
        "webgl",
        "example",
        "seed",
        "types",
        "typescript"
    ],
    "author": "Alain Galvan",
    "license": "Unlicense",
    "bugs": {
        "url": "https://github.com/GhostCrab/webgpu/issues"
    },
    "homepage": "https://github.com/GhostCrab/webgpu#readme",
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@types/node": "^24.19.2",
        "@webgpu/types": "^0.1.26",
        "clean-webpack-plugin": "^4.0.x",
        "concurrently": "^9.2.1",
        "cross-env": "^7.0.x",
        "eslint": "^10.15.0",
        "http-server": "^14.1.x",
        "ts-loader": "^9.4.x",
        "ts-node": "^10.9.x",
        "typescript": "^5.9.3",
        "typescript-eslint": "^8.72.2",
        "vitest": "^5.1.0",
        "webgpu": "^0.6.2",
        "webpack": "^5.75.x"
    },
    "dependencies": {
        "game-inputs": "^0.8.0",
        "gl-matrix": "^3.4.3",
        "webgpu-utils": "^2.1.1",
        "wgpu-matrix": "^2.5.1"
    }
}
